{
  // W4/F82 — the design-sync previews, typechecked.
  //
  // The 37 preview files under `.design-sync/previews/` were in NO program at all. The root
  // config's `include` is `["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"]`, and
  // TypeScript's wildcard expansion SKIPS directories whose name begins with a dot unless the
  // path names them explicitly. `.design-sync/` is such a directory, so `**/*.tsx` never reached
  // it — nothing to do with `open-pro-next` being unresolvable, which is what NOTES.md used to
  // claim. Consequence measured at `de1cd33`: planted drift in a preview survived BOTH `tsc` and
  // the full suite, and the clean tree already carried 19 errors across 8 previews.
  //
  // Why a SECOND config rather than widening the root's `include`:
  //   1. `paths` must map `open-pro-next` → the generated entry, and that mapping is a LIE
  //      everywhere else in the repo (app code must never import the design bundle). Scoping it
  //      to this program keeps it true where it is true.
  //   2. `jsx` must be `react-jsx`; the root is `preserve` (Next transforms it downstream). A
  //      preview is never built by Next, so it needs the real transform to typecheck its JSX.
  //   3. The previews directory is SHARED with `config.marketing.json`, whose 21 previews import
  //      marketing components through a different bundle global. They are excluded below rather
  //      than pulled into a program built for the demo's mapping.
  //
  // The mapping is what makes this load-bearing: `open-pro-next` resolves to the same generated
  // `ds-entry.ts` the bundler builds from, so a preview is typechecked against the REAL component
  // props. Prop drift is now a compile error on every `pnpm typecheck`, which is why F82 refuses
  // U8.4's D-2 ledger proposal as superseded.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": false,
    "paths": {
      "@/*": ["./*"],
      // THE load-bearing line. `ds-entry.ts` is generated by `gen-entry.mjs` from
      // `config.json`'s `componentSrcMap`, so this program and the shipped bundle resolve the
      // same 37 components from the same source files.
      "open-pro-next": ["./.design-sync/ds-entry.ts"],

      // Pin React to the REPO's copy. Without these three the program loads TWO React type
      // trees and reports ~20 spurious TS2322s about `Property.BorderBlockStyle` being
      // "not assignable to" itself.
      //
      // Why it happens: the build recipe has every checkout symlink
      // `.design-sync/node_modules` → `.ds-sync/node_modules` (it is what makes ESM resolve
      // `ts-morph` for `gen-dts-props.mjs`), and `.ds-sync/package.json` carries its own
      // `@types/react`. Node resolution walks UP from the importing file, so a preview under
      // `.design-sync/` finds that copy first, while `ds-entry.ts`'s transitive
      // `features/demo/ui/**` imports find the repo's. Same nominal types from two trees do not
      // unify, and every `style={{…}}` on a lifted `CSSProperties` fragment reds.
      //
      // Three entries, not one: `react/jsx-runtime` is what `jsx: react-jsx` emits, and
      // `csstype` is the transitive dependency the mismatch actually surfaces on.
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "csstype": ["./node_modules/@types/react/node_modules/csstype", "./node_modules/csstype"]
    }
  },
  "include": [".design-sync/previews/**/*.tsx", ".design-sync/ds-entry.ts"],
  "exclude": [
    "node_modules",
    // config.marketing.json's previews — a different bundle, a different global, and they import
    // components this program's `paths` does not map. Listed explicitly rather than filtered by a
    // pattern: the two sets share one directory and only an enumeration can separate them.
    ".design-sync/previews/AppDemo.tsx",
    ".design-sync/previews/BetaCta.tsx",
    ".design-sync/previews/BetaForm.tsx",
    ".design-sync/previews/BetaNextSteps.tsx",
    ".design-sync/previews/BetaPageView.tsx",
    ".design-sync/previews/BetaStrip.tsx",
    ".design-sync/previews/BoldText.tsx",
    ".design-sync/previews/ChainOfWork.tsx",
    ".design-sync/previews/CornerBrackets.tsx",
    ".design-sync/previews/EvidenceManifest.tsx",
    ".design-sync/previews/FeaturePage.tsx",
    ".design-sync/previews/FeatureRowView.tsx",
    ".design-sync/previews/Footer.tsx",
    ".design-sync/previews/Header.tsx",
    ".design-sync/previews/Hero.tsx",
    ".design-sync/previews/Logo.tsx",
    ".design-sync/previews/ManifestTabStrip.tsx",
    ".design-sync/previews/MarketingPhoneFrame.tsx",
    ".design-sync/previews/PrevNext.tsx",
    ".design-sync/previews/RoadmapTease.tsx",
    ".design-sync/previews/TipCard.tsx"
  ]
}
